    <!-- Interactive JavaScript Logic -->
    <script>
        // State
        let selectedCapacity = '32GB';
        let basePrice = 29.99;
        let selectedColor = 'orange';
        let cart = [];

        // Capacity Buttons Selection
        const capacityBtns = document.querySelectorAll('.capacity-btn');
        capacityBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                capacityBtns.forEach(b => {
                    b.classList.remove('border-2', 'border-brand-orange', 'bg-brand-orange/10', 'text-white');
                    b.classList.add('border', 'border-brand-border', 'bg-brand-dark/50', 'text-gray-300');
                });
                btn.classList.remove('border', 'border-brand-border', 'bg-brand-dark/50', 'text-gray-300');
                btn.classList.add('border-2', 'border-brand-orange', 'bg-brand-orange/10', 'text-white');

                selectedCapacity = btn.dataset.capacity;
                basePrice = parseFloat(btn.dataset.price);
                updateTotalPrice();
            });
        });

        // Color Buttons Selection
        const colorBtns = document.querySelectorAll('.color-btn');
        const grad1 = document.getElementById('svg-grad-1');
        const grad2 = document.getElementById('svg-grad-2');

        colorBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                colorBtns.forEach(b => {
                    b.classList.remove('border-2', 'border-brand-neon');
                    b.classList.add('border', 'border-brand-border');
                });
                btn.classList.remove('border', 'border-brand-border');
                btn.classList.add('border-2', 'border-brand-neon');

                selectedColor = btn.dataset.color;
                const c1 = btn.dataset.c1;
                const c2 = btn.dataset.c2;
                
                // Dynamically update SVG Car gradient colors
                if(grad1 && grad2) {
                    grad1.setAttribute('stop-color', c1);
                    grad2.setAttribute('stop-color', c2);
                }
            });
        });

        // Engraving Input listener
        const engravingInput = document.getElementById('engraving-input');
        engravingInput.addEventListener('input', () => {
            updateTotalPrice();
        });

        function updateTotalPrice() {
            let total = basePrice;
            if (engravingInput.value.trim().length > 0) {
                total += 4.99;
            }
            document.getElementById('total-price').textContent = `$${total.toFixed(2)}`;
        }

        // Cart Drawer Logic
        const cartDrawer = document.getElementById('cart-drawer');
        const cartPanel = cartDrawer.querySelector('.id-cart-panel');
        const openCartBtn = document.getElementById('open-cart-btn');
        const closeCartBtn = document.getElementById('close-cart-btn');
        const cartBackdrop = document.getElementById('cart-backdrop');
        const addToCartBtn = document.getElementById('add-to-cart-btn');

        function openCart() {
            cartDrawer.classList.remove('pointer-events-none', 'opacity-0');
            cartPanel.classList.remove('translate-x-full');
        }

        function closeCart() {
            cartDrawer.classList.add('pointer-events-none', 'opacity-0');
            cartPanel.classList.add('translate-x-full');
        }

        openCartBtn.addEventListener('click', openCart);
        closeCartBtn.addEventListener('click', closeCart);
        cartBackdrop.addEventListener('click', closeCart);

        // Add to Cart Action
        addToCartBtn.addEventListener('click', () => {
            const engraving = engravingInput.value.trim();
            const itemPrice = basePrice + (engraving ? 4.99 : 0);
            
            const item = {
                id: Date.now(),
                title: `STEM Racing USB Keychain (${selectedCapacity})`,
                color: selectedColor,
                engraving: engraving || 'None',
                price: itemPrice
            };

            cart.push(item);
            renderCart();
            openCart();
        });

        function renderCart() {
            const container = document.getElementById('cart-items-container');
            const cartBadge = document.getElementById('cart-badge');
            
            if (cart.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-12 text-gray-500">
                        <i class="fa-solid fa-cart-flatbed text-4xl mb-3"></i>
                        <p class="text-sm">Your cart is empty.</p>
                    </div>
                `;
                cartBadge.classList.add('opacity-0');
                document.getElementById('cart-subtotal').textContent = '$0.00';
                document.getElementById('cart-total').textContent = '$0.00';
                return;
            }

            cartBadge.textContent = cart.length;
            cartBadge.classList.remove('opacity-0');

            let subtotal = 0;
            container.innerHTML = cart.map((item, index) => {
                subtotal += item.price;
                return `
                    <div class="bg-brand-dark p-4 rounded-xl border border-brand-border flex items-center justify-between">
                        <div class="space-y-1">
                            <h4 class="text-xs font-bold text-white">${item.title}</h4>
                            <p class="text-[11px] text-gray-400">Finish: <span class="capitalize text-brand-neon">${item.color}</span></p>
                            ${item.engraving !== 'None' ? `<p class="text-[10px] text-brand-orange font-mono">Engraving: ${item.engraving}</p>` : ''}
                            <span class="text-xs font-bold text-white font-mono">$${item.price.toFixed(2)}</span>
                        </div>
                        <button onclick="removeItem(${index})" class="text-gray-500 hover:text-red-400 p-2">
                            <i class="fa-solid fa-trash-can text-sm"></i>
                        </button>
                    </div>
                `;
            }).join('');

            document.getElementById('cart-subtotal').textContent = `$${subtotal.toFixed(2)}`;
            document.getElementById('cart-total').textContent = `$${subtotal.toFixed(2)}`;
        }

        window.removeItem = function(index) {
            cart.splice(index, 1);
            renderCart();
        }

        // Checkout Modal Logic
        const checkoutBtn = document.getElementById('checkout-btn');
        const checkoutModal = document.getElementById('checkout-modal');
        const closeModalBtn = document.getElementById('close-modal-btn');
        const checkoutForm = document.getElementById('checkout-form');
     checkoutBtn.addEventListener('click', () => {
            if(cart.length === 0) return;
            closeCart();
            checkoutModal.classList.remove('hidden');
        });

        closeModalBtn.addEventListener('click', () => {
            checkoutModal.classList.add('hidden');
        });

        checkoutForm.addEventListener('submit', (e) => {
            e.preventDefault();
            alert('Order simulated successfully! Thank you for supporting Veloce Dynamics STEM Racing.');
            cart = [];
            renderCart();
            checkoutModal.classList.add('hidden');
        });
    </script>
